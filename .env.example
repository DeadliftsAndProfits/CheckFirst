# ============================================================================
# Check First — environment variables
# Copy to .env.local and fill in the keys you have. The app runs WITHOUT any of
# these: providers that lack credentials return status "not_configured" and the
# UI represents that honestly. Nothing is faked in production.
# ============================================================================

# --- Application ---------------------------------------------------------
# Comma-separated. Leave DEMO on in development to see fully-populated fixtures
# (always clearly labelled "Demo data"). MUST be false in production.
CHECKFIRST_DEMO_MODE=true

# --- Web / search discovery ----------------------------------------------
# Google Programmable Search Engine (Custom Search JSON API).
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Bing Web Search (alternative to Google CSE).
# https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_API_KEY=

# --- Australian Business Register / ABN Lookup ---------------------------
# ABR Web Services GUID (free registration).
# https://abr.business.gov.au/Tools/WebServices
ABR_GUID=

# --- Email breach status (licensed, status-only — never dumps) -----------
# Have I Been Pwned API key. https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Rate limiting -------------------------------------------------------
# Max searches per IP per rolling window (window seconds).
CHECKFIRST_RATE_LIMIT_MAX=20
CHECKFIRST_RATE_LIMIT_WINDOW_SECONDS=60
