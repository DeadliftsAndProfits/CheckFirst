# ============================================================================
# Check First — environment variables
# Copy to .env.local and fill in the keys you have. The app runs WITHOUT any of
# these: providers that lack credentials return status "not_configured" and the
# UI represents that honestly. Nothing is faked in production.
# ============================================================================

# --- Application ---------------------------------------------------------
# Demo fixtures are OFF by default. Set to true ONLY to preview fully-populated
# sample data in development (always clearly labelled "Demo data"). Normal and
# production searches must never use fixtures — leave this false/unset.
CHECKFIRST_DEMO_MODE=false

# --- Web search router (Brave → You.com → Tavily) ------------------------
# A single web query is served by ONE engine per investigation (sticky), with
# operational fallback to the next configured engine. All are RAW web search
# (no LLM answer/research endpoints). The app runs with zero, one, or all three.

# Brave Search API — https://api-dashboard.search.brave.com/  (~1 req/sec free)
BRAVE_SEARCH_API_KEY=

# You.com Web Search API — https://you.com/docs  (Web Search endpoint only;
# NOT the Answer or Research APIs). ~100 calls/day free.
YOU_SEARCH_API_KEY=

# Tavily Search API — https://tavily.com  (basic mode, no LLM). 1,000/mo free.
TAVILY_API_KEY=

# Router controls (all optional):
# Preferred engine order.
SEARCH_PROVIDER_ORDER=brave,you,tavily
# Per-engine kill switch (default on): set to false to disable one.
# BRAVE_SEARCH_ENABLED=true
# YOU_SEARCH_ENABLED=true
# TAVILY_SEARCH_ENABLED=true
# Circuit-breaker ceiling on web queries per investigation (NOT a target).
SEARCH_QUERY_SAFETY_MAX=12
# Optional global cache TTL override (seconds); otherwise per-kind defaults apply.
# SEARCH_CACHE_TTL_SECONDS=

# Google Programmable Search / Bing — legacy, NOT used by the router (Google CSE
# is being retired Jan 2027). Left here only for any dormant integration.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BING_SEARCH_API_KEY=

# --- Australian Business Register / ABN Lookup ---------------------------
# ABR Web Services GUID (free registration).
# https://abr.business.gov.au/Tools/WebServices
ABR_GUID=

# --- Email breach status (licensed, status-only — never dumps) -----------
# Have I Been Pwned API key. https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- Rate limiting -------------------------------------------------------
# Max searches per IP per rolling window (window seconds).
CHECKFIRST_RATE_LIMIT_MAX=20
CHECKFIRST_RATE_LIMIT_WINDOW_SECONDS=60
